 "structures": [
  {
   "id": "non-solo",
   "regex": "(?i)\\bnon (?:è )?solo\\b[^.!?\\n]{2,80}\\bma anche\\b",
   "name": "\"Non solo X ma anche Y\"",
   "fix": "Due frasi, o togli la metà più debole."
  },
  {
   "id": "non-e-x-e-y",
   "regex": "(?i)\\bnon (?:è|si tratta di) (?:solo |soltanto )?[^.!?\\n]{2,60}[,.] (?:è|si tratta di)\\b",
   "name": "\"Non è X, è Y\"",
   "fix": "Di' subito Y. Il ribaltamento è il segnale."
  },
  {
   "id": "il-risultato",
   "regex": "(?im)^\\s*(?:il risultato|il bello|la sorpresa|il trucco)\\?\\s*$",
   "name": "Riga con domanda retorica di una parola",
   "fix": "Rispondi nella stessa frase invece di preparare il colpo di scena."
  },
  {
   "id": "triade",
   "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
   "name": "Triade da tre",
   "fix": "Due o quattro elementi: il tre è il ritmo di default dei modelli."
  },
  {
   "id": "emoji-ai",
   "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\U0001F3AF\\U0001F4AF]",
   "name": "Emoji razzo / fuoco / lampadina / bersaglio / 100",
   "fix": "Al massimo un emoji per riga, tra quelli del brand (🌿 💧 🪻 🍋 ✨ 🌙)."
  },
  {
   "id": "muro-hashtag",
   "regex": "(?:#\\w+[ \\t]*){7,}",
   "name": "Muro di hashtag (7+)",
   "fix": "Regola del progetto: 4-6 su Instagram, 3-5 su TikTok e Facebook."
  },
  {
   "id": "ecco-cosa",
   "regex": "(?i)\\becco (?:cosa|tutto quello che) (?:devi sapere|ho imparato|c'è da sapere)\\b",
   "name": "\"Ecco cosa devi sapere\"",
   "fix": "Di' la cosa, salta l'annuncio."
  },
  {
   "id": "come-ai",
   "regex": "(?i)\\bcome (?:intelligenza artificiale|modello linguistico|ia)\\b",
   "name": "Traccia di assistente AI",
   "fix": "Togli la frase."
  },
  {
   "id": "cta-spinta",
   "regex": "(?i)\\b(?:che aspetti|non lasciarti sfuggire|corri a|affrettati|solo per oggi)\\b",
   "name": "Invito commerciale (\"che aspetti?\", \"corri a\")",
   "fix": "Tono non commerciale: chiudi con la domanda della rubrica o con l'invito a salvare."
  },
  {
   "id": "elisir",
   "regex": "(?i)\\belisir\\b",
   "name": "\"Elisir\"",
   "fix": "Parola da pubblicità: di' cosa fa la miscela, in parole semplici."
  }
 ]
